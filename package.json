{
  "name": "@swc/workspace",
  "private": true,
  "catalog": {
    "@napi-rs/cli": "^3.5.1",
    "@taplo/cli": "^0.7.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "zx": "^8.8.5"
  },
  "catalogs": {
    "babel": {
      "@babel/compat-data": "^7.29.0",
      "@babel/core": "^7.29.0",
      "@babel/generator": "^7.29.1",
      "@babel/parser": "^7.29.0",
      "@babel/plugin-proposal-class-properties": "^7.18.6",
      "@babel/plugin-proposal-decorators": "^7.29.0",
      "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
      "@babel/preset-env": "^7.29.2",
      "@babel/preset-react": "^7.28.5",
      "@babel/preset-typescript": "^7.28.5",
      "@babel/types": "^7.29.0"
    }
  },
  "workspaces": [
    "./.github/bot",
    "./.github/swc-ecosystem-ci",
    "./packages/*",
    "./packages/core/scripts/npm/*",
    "./packages/minifier/scripts/npm/*",
    "./packages/html/scripts/npm/*",
    "./packages/react-compiler/scripts/npm/*",
    "./bindings/*",
    "./bindings/binding_core_wasm/*",
    "./bindings/binding_core_wasm/example",
    "./pkgs",
    "./pkgs/packages/*",
    "./pkgs/packages/cli/examples/*",
    "./pkgs/packages/swc-loader/example*",
    "./extra-bindings",
    "./extra-bindings/packages/*",
    "./extra-bindings/packages/css/scripts/npm/*",
    "./plugins",
    "./plugins/packages/*",
    "./plugins/contrib/*",
    "./crates/swc_ecma_minifier"
  ],
  "scripts": {
    "changelog": "git cliff --output CHANGELOG.md; git cliff --output CHANGELOG-CORE.md --config cliff-core.toml",
    "prepare": "git config feature.manyFiles true && bun ./crates/swc_ecma_preset_env/scripts/copy-data.js",
    "build": "cd ./packages/core && bun run build",
    "build:dev": "cd ./packages/core && bun run build:dev",
    "test": "cd ./packages/core && bun test __tests__ e2e",
    "test:core": "cd ./packages/core && bun test __tests__ e2e",
    "test:minifier": "cd ./packages/minifier && bun run test",
    "test:html": "cd ./packages/html && bun run test",
    "test:react-compiler": "cd ./packages/react-compiler && bun run test",
    "refresh:packages": "bun tools/bun/refresh-packages.ts",
    "refresh:packages:dry-run": "bun tools/bun/refresh-packages.ts --dry-run"
  },
  "devDependencies": {
    "@babel/compat-data": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/types": "^7.29.0",
    "@swc/helpers": "workspace:^",
    "@taplo/cli": "^0.7.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/terser": "^3.12.0",
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "axios": "^1.13.6",
    "babel-plugin-polyfill-corejs3": "^0.14.2",
    "babel-plugin-transform-node-env-inline": "^0.4.3",
    "benchmark": "^2.1.4",
    "bootstrap": "^5.3.8",
    "class-validator": "^0.15.1",
    "core-js": "^3.49.0",
    "core-js-compat": "^3.49.0",
    "cspell": "^9.7.0",
    "glob": "^13.0.6",
    "js-beautify": "^1.15.4",
    "lint-staged": "^16.4.0",
    "lodash": "^4.17.23",
    "prettier": "^3.8.1",
    "progress": "^2.0.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "^0.14.1",
    "source-map": "^0.7.6",
    "source-map-support": "^0.5.21",
    "sourcemap-validator": "^2.1.0",
    "swc-plugin-coverage-instrument": "^0.0.32",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3",
    "zx": "^8.8.5"
  },
  "lint-staged": {
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ],
    "*.json": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.js": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.ts": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.jsx": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.tsx": [
      "prettier --write"
    ]
  },
  "version": "1.5.30-nightly-20240614.2",
  "engines": {
    "bun": ">=1.3.11"
  },
  "type": "module",
  "trustedDependencies": [
    "core-js"
  ]
}
