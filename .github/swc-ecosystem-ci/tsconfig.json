{
  "include": [
    "./**/*.ts",
    "tests/.*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/workspace/**"
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "esnext"
    ],
    "noEmit": true
  }
}
