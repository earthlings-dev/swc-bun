{
  "name": "@swc/core",
  "version": "1.15.19-nightly-20260302.1",
  "description": "Super-fast alternative for babel",
  "homepage": "https://swc.rs",
  "main": "./src/index.ts",
  "author": "강동윤 <kdy1997.dev@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "swc",
    "swcpack",
    "babel",
    "typescript",
    "rust",
    "webpack",
    "tsc"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/swc-project/swc/issues"
  },
  "napi": {
    "binaryName": "swc",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "powerpc64le-unknown-linux-gnu",
      "s390x-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "bun src/postinstall.ts",
    "artifacts": "napi artifacts --npm-dir scripts/npm",
    "prepack": "napi prepublish -p scripts/npm --tag-style npm --skip-optional-publish && bun scripts/copy-readme.js",
    "pack": "wasm-pack",
    "build:wasm": "wasm-pack build ../../bindings/binding_core_wasm --scope swc --features plugin",
    "build": "napi build --manifest-path ../../Cargo.toml --platform -p binding_core_node --js ./binding.js --dts ./binding.d.ts --release -o .",
    "build:dev": "napi build --manifest-path ../../Cargo.toml --platform -p binding_core_node --js ./binding.js --dts ./binding.d.ts -o .",
    "test": "bun test __tests__ e2e",
    "version": "napi version --npm-dir scripts/npm"
  },
  "peerDependencies": {
    "@swc/helpers": "latest"
  },
  "peerDependenciesMeta": {
    "@swc/helpers": {
      "optional": true
    }
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/swc"
  },
  "files": [
    "README.md",
    "binding.d.ts",
    "binding.js",
    "package.json",
    "src/index.ts",
    "src/postinstall.ts",
    "src/spack.ts",
    "src/util.ts",
    "src/Visitor.ts"
  ],
  "dependencies": {
    "@swc/counter": "workspace:*",
    "@swc/types": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "optionalDependencies": {
    "@swc/core-darwin-x64": "workspace:*",
    "@swc/core-win32-x64-msvc": "workspace:*",
    "@swc/core-linux-x64-gnu": "workspace:*",
    "@swc/core-linux-ppc64-gnu": "workspace:*",
    "@swc/core-linux-s390x-gnu": "workspace:*",
    "@swc/core-linux-x64-musl": "workspace:*",
    "@swc/core-win32-ia32-msvc": "workspace:*",
    "@swc/core-linux-arm-gnueabihf": "workspace:*",
    "@swc/core-darwin-arm64": "workspace:*",
    "@swc/core-linux-arm64-gnu": "workspace:*",
    "@swc/core-linux-arm64-musl": "workspace:*",
    "@swc/core-win32-arm64-msvc": "workspace:*"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./Visitor": {
      "bun": "./src/Visitor.ts",
      "default": "./src/Visitor.ts"
    },
    "./spack": {
      "bun": "./src/spack.ts",
      "default": "./src/spack.ts"
    },
    "./util": {
      "bun": "./src/util.ts",
      "default": "./src/util.ts"
    },
    "./package.json": "./package.json"
  }
}
