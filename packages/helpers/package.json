{
    "name": "@swc/helpers",
    "version": "0.5.19",
    "description": "External helpers for the swc project.",
    "module": "./esm/index.js",
    "main": "./esm/index.js",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/swc-project/swc.git",
        "directory": "packages/helpers"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "keywords": [
        "swc",
        "helpers"
    ],
    "author": "강동윤 <kdy1997.dev@gmail.com>",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/swc-project/swc/issues"
    },
    "homepage": "https://swc.rs",
    "type": "module",
    "devDependencies": {},
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "exports": {
        ".": {
            "bun": "./esm/index.js",
            "default": "./esm/index.js"
        },
        "./_": {
            "bun": "./esm/index.js",
            "default": "./esm/index.js"
        },
        "./_/*": {
            "bun": "./esm/*.js",
            "default": "./esm/*.js"
        },
        "./esm/*": "./esm/*",
        "./package.json": "./package.json"
    },
    "files": [
        "LICENSE",
        "package.json",
        "esm"
    ]
}
