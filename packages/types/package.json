{
    "name": "@swc/types",
    "version": "0.1.25",
    "description": "Typings for the swc project.",
    "types": "./index.ts",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/swc-project/swc.git",
        "directory": "packages/types"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "files": [
        "LICENSE",
        "README.md",
        "assumptions.ts",
        "index.ts",
        "package.json"
    ],
    "keywords": [
        "swc",
        "types"
    ],
    "author": "강동윤 <kdy1997.dev@gmail.com>",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/swc-project/swc/issues"
    },
    "homepage": "https://swc.rs",
    "devDependencies": {
        "@types/bun": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@swc/counter": "workspace:*"
    },
    "main": "./index.ts",
    "exports": {
        ".": {
            "bun": "./index.ts",
            "default": "./index.ts"
        },
        "./assumptions": {
            "bun": "./assumptions.ts",
            "default": "./assumptions.ts"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "bun": ">=1.3.11"
    }
}
